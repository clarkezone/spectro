<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Spectro.WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Spectro.WinUI"
    Loaded="MainPage_Loaded"
    SizeChanged="MainPage_SizeChanged">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SidebarBrush" Color="#F0EFEC" />
                    <SolidColorBrush x:Key="ListBrush" Color="#FAF9F6" />
                    <SolidColorBrush x:Key="PaperBrush" Color="#FFFEFB" />
                    <SolidColorBrush x:Key="InkBrush" Color="#242725" />
                    <SolidColorBrush x:Key="MutedInkBrush" Color="#646863" />
                    <SolidColorBrush x:Key="RuleBrush" Color="#E4E3DE" />
                    <SolidColorBrush x:Key="BrandBrush" Color="#A44B25" />
                    <SolidColorBrush x:Key="SelectionBrush" Color="#E8E5DD" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="SidebarBrush" Color="#202321" />
                    <SolidColorBrush x:Key="ListBrush" Color="#272A27" />
                    <SolidColorBrush x:Key="PaperBrush" Color="#1B1E1C" />
                    <SolidColorBrush x:Key="InkBrush" Color="#EDEDE7" />
                    <SolidColorBrush x:Key="MutedInkBrush" Color="#ADB2AB" />
                    <SolidColorBrush x:Key="RuleBrush" Color="#3B403A" />
                    <SolidColorBrush x:Key="BrandBrush" Color="#EFA77F" />
                    <SolidColorBrush x:Key="SelectionBrush" Color="#3A4038" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="SidebarBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ListBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PaperBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="InkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="MutedInkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="RuleBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="BrandBrush" Color="{ThemeResource SystemColorHotlightColor}" />
                    <SolidColorBrush x:Key="SelectionBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="QuietButton" TargetType="Button">
                <Setter Property="MinWidth" Value="44" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
            </Style>
            <Style x:Key="LibraryItemStyle" TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="8,1" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="StoryItemStyle" TargetType="ListViewItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="8,2" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="FeedItemStyle" TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="8,0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="SyncAccelerator_Invoked" />
        <KeyboardAccelerator Key="S" Modifiers="Control,Shift" Invoked="SaveAccelerator_Invoked" />
        <KeyboardAccelerator Key="M" Modifiers="Control,Shift" Invoked="ReadAccelerator_Invoked" />
        <KeyboardAccelerator Key="D" Modifiers="Control" Invoked="SettingsAccelerator_Invoked" />
        <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OpenAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid x:Name="Root" Background="{ThemeResource PaperBrush}">
        <Grid x:Name="LoadingPanel" AutomationProperties.AutomationId="LoadingPanel">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
                <FontIcon Glyph="&#xE8A5;" FontSize="36" Foreground="{ThemeResource BrandBrush}" />
                <TextBlock Text="Your reading, uninterrupted." FontFamily="Georgia" FontSize="26" />
                <ProgressRing Width="24" Height="24" IsActive="True" AutomationProperties.Name="Loading Spectro" />
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="LoginPanel" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="LoginPanel">
            <StackPanel MaxWidth="380" Padding="24,64" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
                <FontIcon Glyph="&#xE8A5;" FontSize="40" HorizontalAlignment="Left" Foreground="{ThemeResource BrandBrush}" />
                <TextBlock Text="A little space&#x0a;to read." FontFamily="Georgia" FontSize="42" Foreground="{ThemeResource InkBrush}" />
                <TextBlock Text="Welcome to Spectro. Your favorite publications, a quieter reading experience, and a library that travels offline."
                           TextWrapping="Wrap" Foreground="{ThemeResource MutedInkBrush}" FontSize="15" />
                <InfoBar x:Name="LoginStatus" IsClosable="False" IsOpen="False" Severity="Warning"
                         Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Title="{x:Bind ViewModel.StatusTitle, Mode=OneWay}" />
                <TextBox x:Name="UsernameBox" Header="NewsBlur username" MinHeight="44"
                         AutomationProperties.AutomationId="Username" AutomationProperties.Name="NewsBlur username"
                         Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <PasswordBox x:Name="PasswordBox" Header="Password" MinHeight="44"
                             AutomationProperties.AutomationId="Password" AutomationProperties.Name="NewsBlur password"
                             PasswordChanged="PasswordBox_PasswordChanged" />
                <Button MinHeight="44" HorizontalAlignment="Stretch" Content="Sign in to NewsBlur"
                        Style="{StaticResource AccentButtonStyle}" Click="SignIn_Click"
                        AutomationProperties.AutomationId="SignIn" IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}" />
                <TextBlock Text="Your password is never stored. Your session is protected by Windows Password Vault."
                           FontSize="12" Foreground="{ThemeResource MutedInkBrush}" TextWrapping="Wrap" />
                <ProgressBar x:Name="LoginProgress" IsIndeterminate="True" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <ContentControl x:Name="ReaderHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Grid x:Name="ReaderPanel" AutomationProperties.AutomationId="ReaderShell">
            <Grid x:Name="PaneGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="NavigationColumn" Width="224" />
                    <ColumnDefinition x:Name="FeedColumn" Width="280" />
                    <ColumnDefinition x:Name="StoryColumn" Width="340" />
                    <ColumnDefinition x:Name="ReaderColumn" Width="*" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="NavigationPane" Background="{ThemeResource SidebarBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="24,28,20,24" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8A5;" FontSize="23" Foreground="{ThemeResource BrandBrush}" />
                            <TextBlock Text="spectro" FontSize="27" FontWeight="SemiBold" CharacterSpacing="-30" Foreground="{ThemeResource InkBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="BrandTagline" Text="A quieter kind of reader." Foreground="{ThemeResource MutedInkBrush}" FontSize="12" />
                        <TextBox x:Name="FeedSearch" PlaceholderText="Search news feeds" MinHeight="36" Margin="0,8,0,0"
                                 TextChanged="FeedSearch_TextChanged" AutomationProperties.Name="Search news feeds" />
                        <TextBlock Text="YOUR LIBRARY" Margin="0,12,0,0" FontSize="10" CharacterSpacing="160" Foreground="{ThemeResource MutedInkBrush}" />
                    </StackPanel>
                    <ListView x:Name="NavigationList" Grid.Row="1" SelectionMode="Single" IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
                              SelectionChanged="NavigationList_SelectionChanged"
                              ItemContainerStyle="{StaticResource LibraryItemStyle}"
                              AutomationProperties.AutomationId="NavigationList" AutomationProperties.Name="Library and subscriptions">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:NavigationItemView">
                                <Grid Padding="12,8" ColumnSpacing="10" MinHeight="44" AutomationProperties.Name="{x:Bind Title}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Foreground="{ThemeResource MutedInkBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontWeight="{x:Bind TitleWeight}" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{ThemeResource InkBrush}" TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind Title}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind CountText}" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{ThemeResource MutedInkBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid Grid.Row="2" Padding="16,12" BorderBrush="{ThemeResource RuleBrush}" BorderThickness="0,1,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="NEWSBLUR" FontSize="10" CharacterSpacing="100" Foreground="{ThemeResource MutedInkBrush}" />
                            <TextBlock x:Name="LibraryStatus" Text="Your local library" FontSize="12" Foreground="{ThemeResource MutedInkBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource QuietButton}" Click="Settings_Click"
                                ToolTipService.ToolTip="Settings (Ctrl+D)" AutomationProperties.AutomationId="Settings" AutomationProperties.Name="Settings">
                            <FontIcon Glyph="&#xE713;" FontSize="17" />
                        </Button>
                    </Grid>
                </Grid>

                <Grid x:Name="FeedPane" Grid.Column="1" Background="{ThemeResource SidebarBrush}" BorderBrush="{ThemeResource RuleBrush}" BorderThickness="1,0,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Margin="22,24,22,16">
                        <TextBlock Text="News feeds" FontSize="25" Foreground="{ThemeResource InkBrush}" />
                    </StackPanel>
                    <ListView x:Name="FeedList" Grid.Row="1" ItemContainerStyle="{StaticResource FeedItemStyle}" IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
                              SelectionChanged="FeedList_SelectionChanged" AutomationProperties.Name="News feeds" AutomationProperties.AutomationId="FeedList">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:NavigationItemView">
                                <Grid MinHeight="32" Padding="8,4" ColumnSpacing="10" AutomationProperties.Name="{x:Bind AccessibleName}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Border Width="24" Height="24" CornerRadius="6" Background="{x:Bind BadgeBrush}">
                                        <TextBlock Text="{x:Bind Initial}" Foreground="White" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontWeight="{x:Bind TitleWeight}" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource InkBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind AccessibleName}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind CountText}" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource MutedInkBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid Grid.Row="2" ColumnSpacing="2" Padding="8" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource RuleBrush}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <ToggleButton x:Name="AllFilterButton" HorizontalAlignment="Stretch" MinHeight="44" Content="All" Tag="all" Click="Filter_Click" IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}" />
                        <ToggleButton x:Name="UnreadFilterButton" Grid.Column="1" HorizontalAlignment="Stretch" MinHeight="44" Content="Unread" Tag="unread" Click="Filter_Click" IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}" />
                        <ToggleButton x:Name="SavedFilterButton" Grid.Column="2" HorizontalAlignment="Stretch" MinHeight="44" Content="Saved" Tag="saved" Click="Filter_Click" IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}" />
                    </Grid>
                </Grid>

                <Grid x:Name="StoryPane" Grid.Column="2" Background="{ThemeResource ListBrush}" BorderBrush="{ThemeResource RuleBrush}" BorderThickness="1,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="StoryHeader" Margin="22,24,16,14" Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="LibraryHeading" Text="Unread" FontSize="25" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1" Style="{StaticResource QuietButton}" Click="Sync_Click"
                                    IsEnabled="{x:Bind ViewModel.CanSynchronize, Mode=OneWay}"
                                    AutomationProperties.AutomationId="Sync" AutomationProperties.Name="Sync now" ToolTipService.ToolTip="Sync now (Ctrl+R)">
                                <FontIcon Glyph="&#xE72C;" FontSize="17" />
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource QuietButton}" Click="Settings_Click"
                                    AutomationProperties.Name="Reading settings" ToolTipService.ToolTip="Reading settings (Ctrl+D)">
                                <FontIcon Glyph="&#xE8D2;" FontSize="17" />
                            </Button>
                        </Grid>
                        <TextBlock x:Name="LibrarySubtitle" FontSize="12" Foreground="{ThemeResource MutedInkBrush}" />
                        <ComboBox x:Name="NavigationPicker" MinHeight="44" HorizontalAlignment="Stretch" IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
                                  SelectionChanged="NavigationPicker_SelectionChanged"
                                  AutomationProperties.AutomationId="NavigationPicker" AutomationProperties.Name="Choose library or subscription">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="local:NavigationItemView">
                                    <TextBlock Text="{x:Bind Title}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <TextBox x:Name="StorySearch" Grid.Row="1" Margin="22,0,22,16" MinHeight="36"
                             PlaceholderText="Search this collection" TextChanged="StorySearch_TextChanged"
                             AutomationProperties.Name="Search downloaded stories" />
                    <ListView x:Name="StoryList" Grid.Row="2" SelectionChanged="StoryList_SelectionChanged" SelectionMode="Single" IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
                              ItemContainerStyle="{StaticResource StoryItemStyle}" IsItemClickEnabled="True" ItemClick="StoryList_ItemClick"
                              AutomationProperties.AutomationId="StoryList" AutomationProperties.Name="Downloaded stories">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate><ItemsStackPanel ItemsUpdatingScrollMode="KeepItemsInView" /></ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:StoryItemView">
                                <Grid Padding="{x:Bind PreviewPadding}" RowSpacing="4" ColumnSpacing="12" AutomationProperties.Name="{x:Bind Title}"
                                      BorderBrush="{ThemeResource RuleBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Source}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource BrandBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind DateLabel}" FontSize="11" Foreground="{ThemeResource MutedInkBrush}" />
                                    </Grid>
                                    <Grid Grid.Row="1" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Title}" FontSize="{x:Bind TitleSize}" FontWeight="{x:Bind TitleWeight}"
                                                   Foreground="{ThemeResource InkBrush}" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                        <FontIcon Grid.Column="1" Glyph="{x:Bind StateGlyph}" FontSize="11" Foreground="{ThemeResource BrandBrush}" VerticalAlignment="Top" Margin="0,5,0,0" />
                                    </Grid>
                                    <TextBlock Grid.Row="2" Text="{x:Bind Summary}" FontSize="12" Foreground="{ThemeResource MutedInkBrush}"
                                               TextWrapping="Wrap" MaxLines="{x:Bind SummaryLines}" TextTrimming="CharacterEllipsis" LineHeight="16" />
                                    <Border Grid.Column="1" Grid.RowSpan="3" Width="{x:Bind ImageSize}" Height="{x:Bind ImageSize}" CornerRadius="5" VerticalAlignment="Top"
                                            Visibility="{x:Bind ThumbnailVisibility}" Background="{ThemeResource SelectionBrush}">
                                        <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                                    </Border>
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="{x:Bind ReadAction}" Tag="{x:Bind}" Click="ToggleRead_Click" />
                                            <MenuFlyoutItem Text="{x:Bind SaveAction}" Tag="{x:Bind}" Click="ToggleSaved_Click" />
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel x:Name="ListEmpty" Grid.Row="2" Margin="28" VerticalAlignment="Center" Spacing="12" Visibility="Collapsed">
                        <FontIcon Glyph="&#xE73E;" FontSize="28" Foreground="{ThemeResource MutedInkBrush}" />
                        <TextBlock x:Name="ListEmptyTitle" Text="All caught up." FontFamily="Georgia" FontSize="23" TextAlignment="Center" Foreground="{ThemeResource InkBrush}" />
                        <TextBlock x:Name="ListEmptyMessage" Text="Choose another collection or sync for new stories." TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource MutedInkBrush}" FontSize="13" />
                    </StackPanel>
                    <Grid Grid.Row="3" Padding="22,12" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource RuleBrush}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon x:Name="SyncStatusIcon" Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource MutedInkBrush}" />
                            <TextBlock x:Name="SyncStatusText" Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Text="Available offline" FontSize="11" Foreground="{ThemeResource MutedInkBrush}"
                                       AutomationProperties.AutomationId="SyncProgress" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
                            <Button x:Name="CancelSyncButton" Grid.Column="2" Content="Cancel" Visibility="Collapsed"
                                    Click="CancelSync_Click" AutomationProperties.AutomationId="CancelSync" AutomationProperties.Name="Cancel sync" />
                    </Grid>
                </Grid>

                <Grid x:Name="ArticlePane" Grid.Column="3" Background="{ThemeResource PaperBrush}">
                    <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid x:Name="ArticleToolbar" Padding="12,8" BorderBrush="{ThemeResource RuleBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button x:Name="ReaderBack" Style="{StaticResource QuietButton}" Visibility="Collapsed"
                                AutomationProperties.AutomationId="BackToStories" AutomationProperties.Name="Back to story list"
                                Click="ReaderBack_Click" ToolTipService.ToolTip="Back to stories">
                            <FontIcon Glyph="&#xE72B;" FontSize="16" />
                        </Button>
                        <TextBlock x:Name="ArticleSource" Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Text="THE READING ROOM"
                                   FontSize="10" CharacterSpacing="130" Foreground="{ThemeResource MutedInkBrush}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                            <Button x:Name="ReadButton" Style="{StaticResource QuietButton}" Click="SelectedRead_Click"
                                    AutomationProperties.AutomationId="ReaderRead" AutomationProperties.Name="Mark as unread" ToolTipService.ToolTip="Mark as unread (Ctrl+Shift+M)">
                                <FontIcon x:Name="ReadIcon" Glyph="&#xE73E;" FontSize="17" />
                            </Button>
                            <Button x:Name="SaveButton" Style="{StaticResource QuietButton}" Click="SelectedSaved_Click"
                                    AutomationProperties.AutomationId="ReaderSave" AutomationProperties.Name="Save story" ToolTipService.ToolTip="Save story (Ctrl+Shift+S)">
                                <FontIcon x:Name="SaveIcon" Glyph="&#xE734;" FontSize="17" />
                            </Button>
                            <Button x:Name="OpenButton" Style="{StaticResource QuietButton}" Click="OpenOriginal_Click"
                                    AutomationProperties.AutomationId="OpenOriginal" AutomationProperties.Name="Open original in browser" ToolTipService.ToolTip="Open original (Ctrl+O)">
                                <FontIcon Glyph="&#xE8A7;" FontSize="17" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <InfoBar x:Name="StatusBar" Grid.Row="1" IsClosable="False" IsOpen="False"
                             Title="{x:Bind ViewModel.StatusTitle, Mode=OneWay}"
                             Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Severity="Warning" />
                    <StackPanel x:Name="ReaderEmpty" Grid.Row="2" MaxWidth="340" Margin="36" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
                        <FontIcon Glyph="&#xE8A5;" FontSize="40" Foreground="{ThemeResource BrandBrush}" />
                        <TextBlock Text="Room for a good read." FontFamily="Georgia" FontSize="30" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource InkBrush}" />
                        <TextBlock Text="Pick a story from your library.&#x0a;Everything here is ready when you are."
                                   TextAlignment="Center" TextWrapping="Wrap" FontSize="14" Foreground="{ThemeResource MutedInkBrush}" LineHeight="23" />
                    </StackPanel>
                    <WebView2 x:Name="ArticleReader" Grid.Row="2" Visibility="Collapsed"
                              AutomationProperties.AutomationId="ArticleReader" AutomationProperties.Name="Article"
                              Loaded="ArticleReader_Loaded" NavigationStarting="ArticleReader_NavigationStarting" />
                </Grid>
            </Grid>
        </Grid>

        </ContentControl>
        <Grid x:Name="SettingsPanel" Visibility="Collapsed" Background="#66000000" AutomationProperties.AutomationId="SettingsPanel">
            <Border x:Name="SettingsCard" Width="400" HorizontalAlignment="Right" Background="{ThemeResource PaperBrush}" Padding="28">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="22">
                        <Grid>
                            <TextBlock Text="Make yourself at home." FontFamily="Georgia" FontSize="22" Margin="0,56,0,0" TextWrapping="Wrap" Foreground="{ThemeResource InkBrush}" />
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource QuietButton}"
                                    AutomationProperties.Name="Close settings" Click="CloseSettings_Click">
                                <FontIcon Glyph="&#xE711;" FontSize="16" />
                            </Button>
                        </Grid>
                        <TextBlock Text="READING" FontSize="10" CharacterSpacing="150" Foreground="{ThemeResource MutedInkBrush}" />
                        <ComboBox x:Name="ThemeBox" Header="Appearance" HorizontalAlignment="Stretch" MinHeight="44" AutomationProperties.AutomationId="Theme" SelectionChanged="Settings_Changed">
                            <ComboBoxItem Content="Follow Windows" /><ComboBoxItem Content="Light" /><ComboBoxItem Content="Dark" />
                        </ComboBox>
                        <NumberBox x:Name="TextSizeBox" Header="Article text size" Minimum="14" Maximum="30" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="SettingsNumber_Changed" />
                        <NumberBox x:Name="ReadingWidthBox" Header="Reading width" Minimum="520" Maximum="1100" SmallChange="20" SpinButtonPlacementMode="Compact" ValueChanged="SettingsNumber_Changed" />
                        <ComboBox x:Name="DefaultFilterBox" Header="Open with" MinHeight="44" HorizontalAlignment="Stretch" SelectionChanged="Settings_Changed">
                            <ComboBoxItem Content="All stories" /><ComboBoxItem Content="Unread" /><ComboBoxItem Content="Saved" /><ComboBoxItem Content="Read stories" />
                        </ComboBox>
                        <NumberBox x:Name="RetentionBox" Header="Keep read stories (days)" Minimum="7" Maximum="365" SmallChange="7" SpinButtonPlacementMode="Compact" ValueChanged="SettingsNumber_Changed" />
                        <ToggleSwitch x:Name="DownloadImagesSwitch" Header="Download article previews" Toggled="DownloadImages_Toggled" />
                        <TextBlock Text="Images are fetched from publishers during sync, without your NewsBlur cookies. Turn this off for text-only downloads."
                                   TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource MutedInkBrush}" />
                        <TextBlock Text="YOUR ACCOUNT" FontSize="10" CharacterSpacing="150" Foreground="{ThemeResource MutedInkBrush}" />
                        <TextBlock Text="Connected through NewsBlur. Saved stories stay in your library. Read and save changes are kept locally until the next sync."
                                   TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource MutedInkBrush}" />
                        <Button MinHeight="44" HorizontalAlignment="Stretch" Click="SignOut_Click" Content="Sign out of NewsBlur" AutomationProperties.AutomationId="SignOut" />
                        <Button MinHeight="44" HorizontalAlignment="Stretch" Click="ResetLocalData_Click" Content="Reset downloaded library" AutomationProperties.AutomationId="ResetLocalData" />
                        <HyperlinkButton MinHeight="44" NavigateUri="https://github.com/clarkezone/spectro/blob/master/PRIVACY.md" Content="Privacy policy" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
